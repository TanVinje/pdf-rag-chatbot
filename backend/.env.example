# OpenAI API Key (required for OpenAI embeddings + chat)
# If not set, falls back to local sentence-transformers for embeddings
OPENAI_API_KEY=

# ChromaDB persistent storage path
CHROMA_PATH=./chroma_db

# Similarity threshold for retrieval (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.25

# Number of top chunks to retrieve
TOP_K=6

# OpenAI model for chat completion
OPENAI_CHAT_MODEL=gpt-4o-mini

# OpenAI embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Admin secret for /ingest endpoint (change this!)
ADMIN_SECRET=change-me-to-something-strong

# Backend host and port
HOST=0.0.0.0
PORT=8000
