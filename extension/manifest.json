{
  "manifest_version": 3,
  "name": "Nexzoneo Support",
  "description": "AI-powered support chatbot for Nexzoneo digital banking",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
