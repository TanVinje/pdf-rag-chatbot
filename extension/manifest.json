{
  "manifest_version": 3,
  "name": "PDF RAG Chatbot",
  "description": "AI chatbot that answers questions from your uploaded PDF documents",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
